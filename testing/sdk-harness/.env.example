# Target: emulator or staging
TEST_TARGET=emulator

# Firebase project and app values
FIREBASE_PROJECT_ID=demo-housing-finder
FIREBASE_API_KEY=demo-key
FIREBASE_AUTH_DOMAIN=demo-housing-finder.firebaseapp.com

# Credentials for test account
HARNESS_EMAIL=agent.test@example.com
