rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function getUserRole() { return request.auth.token.role; }
    function isAdmin() { return isAuthenticated() && getUserRole() == 'Admin'; }
    function clientHasActiveOffer(clientId, propertyId) {
      return exists(
        /databases/$(database)/documents/clientOffers
          .where('clientId', '==', clientId)
          .where('propertyId', '==', propertyId)
          .where('status', '!=', 'withdrawn')
      );
    }
    function propertyHasActiveOffer(propertyId) {
      return exists(
        /databases/$(database)/documents/clientOffers
          .where('propertyId', '==', propertyId)
          .where('status', '!=', 'withdrawn')
      );
    }
    // Checks if agentId is assigned to clientId via an approved clientRequest
    function isAssignedAgent(agentId, clientId) {
      return get(/databases/$(database)/documents/clientRequests/$(clientId + "_" + agentId)).data.status == "Approved";
    }

    // Users collection rules
    match /users/{userId} {
      // Allow create if authenticated and owner, and fields are valid
      allow create: if isAuthenticated() && isOwner(userId)
        && (request.resource.data.firstName is string)
        && (request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() < 50)
        && !(request.resource.data.firstName.matches('.*<script.*'))
        && (request.resource.data.lastName is string)
        && (request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() < 50)
        && !(request.resource.data.lastName.matches('.*<script.*'))
        && (request.resource.data.email is string)
        && (request.resource.data.email.size() > 0 && request.resource.data.email.size() < 100)
        && !(request.resource.data.email.matches('.*<script.*'))
        && (request.resource.data.phoneNumber is string)
        && (request.resource.data.phoneNumber.size() > 0 && request.resource.data.phoneNumber.size() < 25)
        && request.resource.data.phoneNumber.matches('^[0-9+()\-\s]{7,20}$');
      // Allow update if authenticated, owner, NOT changing 'role', and fields are valid
      allow update: if isAuthenticated() && isOwner(userId)
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
        && (request.resource.data.firstName is string)
        && (request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() < 50)
        && !(request.resource.data.firstName.matches('.*<script.*'))
        && (request.resource.data.lastName is string)
        && (request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() < 50)
        && !(request.resource.data.lastName.matches('.*<script.*'))
        && (request.resource.data.email is string)
        && (request.resource.data.email.size() > 0 && request.resource.data.email.size() < 100)
        && !(request.resource.data.email.matches('.*<script.*'))
        && (request.resource.data.phoneNumber is string)
        && (request.resource.data.phoneNumber.size() > 0 && request.resource.data.phoneNumber.size() < 25)
        && request.resource.data.phoneNumber.matches('^[0-9+()\-\s]{7,20}$');
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow get: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        resource.data.role == 'Agent' ||
        (getUserRole() == 'Agent' && resource.data.role == 'Client')
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        getUserRole() == 'Agent' ||
        getUserRole() == 'Client'
      );
    }

    // clientRequests collection rules
    match /clientRequests/{requestId} {
      allow create: if isAuthenticated() && (
        (request.resource.data.clientId == request.auth.uid &&
         request.resource.data.status == "Pending") ||
        (getUserRole() == "Agent" &&
         request.resource.data.status == "Approved")
      );
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid         // Client can read their own requests
        || resource.data.realtorId == request.auth.uid         // Agent can read their assigned requests
        || getUserRole() == "Agent"                              // (Optional) Agent can read all requests
      );
      allow update: if isAuthenticated()
        && resource.data.realtorId == request.auth.uid
        && request.resource.data.realtorId == resource.data.realtorId
        && request.resource.data.clientId == resource.data.clientId;
      allow delete: if isAuthenticated() && (
        resource.data.realtorId == request.auth.uid || resource.data.clientId == request.auth.uid
      );
    }

    // clientFavorites collection rules
    match /clientFavorites/{favoriteId} {
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        getUserRole() == "Agent"
      );
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        getUserRole() == "Agent"
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // clientOffers collection rules
    match /clientOffers/{offerId} {
      allow create: if isAuthenticated() &&
        getUserRole() == "Agent"
        // isAssignedAgent(request.auth.uid, request.resource.data.clientId)
        // !clientHasActiveOffer(request.resource.data.clientId, request.resource.data.propertyId) &&
        // !propertyHasActiveOffer(request.resource.data.propertyId);
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid ||
        getUserRole() == "Agent"
      );
      allow update: if isAuthenticated() && (
        getUserRole() == "Agent"
      );
      allow delete: if isAuthenticated() && (
        getUserRole() == "Agent" || resource.data.clientId == request.auth.uid
      );
    }

    // helpRequests collection rules
    match /helpRequests/{helpRequestId} {
      allow create: if isAuthenticated()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == "Pending";
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.realtorId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.realtorId == request.auth.uid
      )
      && request.resource.data.clientId == resource.data.clientId
      && request.resource.data.realtorId == resource.data.realtorId;
      allow delete: if false;
    }

    // properties collection rules
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // API pull telemetry (admin-only)
    match /apiPullRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Ingest lock state and metadata (admin-only)
    match /systemLocks/{lockId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}