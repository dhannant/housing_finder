rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function getUserRole() {
      return isAuthenticated()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAgent() { return getUserRole() == 'Agent' || getUserRole() == 'agent'; }
    function isClient() { return getUserRole() == 'Client' || getUserRole() == 'client'; }
    function isAdmin() { return isAuthenticated() && (getUserRole() == 'Admin' || getUserRole() == 'admin'); }
    function clientHasActiveOffer(clientId, propertyId) {
      return exists(
        /databases/$(database)/documents/clientOffers
          .where('clientId', '==', clientId)
          .where('propertyId', '==', propertyId)
          .where('status', '!=', 'withdrawn')
      );
    }
    function propertyHasActiveOffer(propertyId) {
      return exists(
        /databases/$(database)/documents/clientOffers
          .where('propertyId', '==', propertyId)
          .where('status', '!=', 'withdrawn')
      );
    }
    // Checks if agentId is assigned to clientId via an approved clientRequest
    function isAssignedAgent(agentId, clientId) {
      return get(/databases/$(database)/documents/clientRequests/$(clientId + "_" + agentId)).data.status == "Approved";
    }

    // Users collection rules
    match /users/{userId} {
      // User profile creation now happens through callable functions.
      allow create: if false;
      // User profile updates and deletes now happen through callable functions.
      allow update: if false;
      allow delete: if false;
      allow get: if isAuthenticated() && (
        isAdmin() ||
        isOwner(userId) ||
        resource.data.role == 'Agent' ||
        (isAgent() && resource.data.role == 'Client')
      );
      allow list: if isAuthenticated() && (
        isAdmin() ||
        isAgent() ||
        isClient()
      );
    }

    // clientRequests collection rules
    match /clientRequests/{requestId} {
      // All writes now happen through callable functions.
      allow create: if false;
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid         // Client can read their own requests
        || resource.data.realtorId == request.auth.uid         // Agent can read their assigned requests
        || isAgent()                              // (Optional) Agent can read all requests
      );
      allow update: if false;
      allow delete: if false;
    }

    // clientFavorites collection rules
    match /clientFavorites/{favoriteId} {
      allow create: if false;
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        isAgent()
      );
      allow delete: if false;
      allow update: if false;
    }

    // clientOffers collection rules
    match /clientOffers/{offerId} {
      allow create: if false;
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid ||
        isAgent()
      );
      allow update: if false;
      allow delete: if false;
    }

    // helpRequests collection rules
    match /helpRequests/{helpRequestId} {
      // All writes now happen through callable functions.
      allow create: if false;
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.realtorId == request.auth.uid
      );
      allow update: if false;
      allow delete: if false;
    }

    // properties collection rules
    match /properties/{propertyId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // propertyDetails collection rules
    match /propertyDetails/{propertyId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // clientPropertyListings collection rules
    match /clientPropertyListings/{listingId} {
      allow create: if false;

      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.clientId == request.auth.uid ||
        resource.data.assignedAgentId == request.auth.uid
      );

      allow update: if false;

      allow delete: if false;
    }

    // API pull telemetry (admin-only)
    match /apiPullRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Ingest lock state and metadata (admin-only)
    match /systemLocks/{lockId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}